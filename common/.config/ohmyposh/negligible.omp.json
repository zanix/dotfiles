{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "foreground": "cyan",
          "style": "powerline",
          "template": "{{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "options": {
            "cachyos": "\uf385"
          }
        },
        {
          "type": "root",
          "foreground": "#F1502F",
          "style": "plain",
          "template": "\udb85\udc0b "
        },
        {
          "type": "path",
          "foreground": "cyan",
          "options": {
            "style": "full"
          },
          "style": "plain",
          "template": "{{ .Path }} "
        },
        {
          "type": "git",
          "foreground": "darkGray",
          "style": "plain",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FFEB3B{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#F1502F{{ end }}",
            "{{ if gt .Ahead 0 }}#89D1DC{{ end }}",
            "{{ if gt .Behind 0 }}#4E9A06{{ end }}"
          ],
          "template": ":: {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} "
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "type": "node",
          "foreground": "#6CA35E",
          "style": "plain",
          "template": "| \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} "
        },
        {
          "type": "go",
          "foreground": "#00ACD7",
          "style": "plain",
          "template": "| \ue627 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "php",
          "foreground": "#4063D8",
          "style": "plain",
          "template": "| \ued6d {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "python",
          "foreground": "#FFDE57",
          "options": {
            "display_mode": "files"
          },
          "style": "plain",
          "template": "| \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "ruby",
          "foreground": "#AE1401",
          "options": {
            "display_mode": "files"
          },
          "style": "plain",
          "template": "| \ue791 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "azfunc",
          "foreground": "#FEAC19",
          "options": {
            "display_mode": "files"
          },
          "style": "plain",
          "template": "| \uf0e7 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "aws",
          "foreground": "#FFFFFF",
          "foreground_templates": [
            "{{if contains \"default\" .Profile}}#FFA400{{end}}",
            "{{if contains \"jan\" .Profile}}#F1184C{{end}}"
          ],
          "options": {
            "display_default": false
          },
          "style": "plain",
          "template": "| \ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} "
        },
        {
          "type": "kubectl",
          "foreground": "#4A65FF",
          "style": "diamond",
          "template": "| \ue81d {{.Context}}</>{{if .Namespace}} :: {{.Namespace}}{{end}} "
        },
        {
          "type": "project",
          "foreground": "#FFA5D8",
          "style": "plain",
          "template": "| \uf487 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Name }}{{ .Name }}{{ end }}{{ if .Target }} {{ .Target }}{{ end }}{{ end }} "
        },
        {
          "type": "executiontime",
          "foreground": "#FFEB3B",
          "options": {
            "threshold": 5000
          },
          "style": "plain",
          "template": "| \uf252 {{ .FormattedMs }} "
        },
        {
          "type": "status",
          "foreground": "#D3D7CF",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#CC2222{{ end }}",
            "{{ if eq .Code 0 }}#D3D7CF{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "{{ if gt .Code 0 }}{{ reason .Code }}{{ else }}\uf42e{{ end }} "
        },
        {
          "type": "text",
          "foreground": "darkGray",
          "style": "plain",
          "template": "\u2500\u256e"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "foreground": "darkGray",
          "style": "plain",
          "template": "\u2570\u2500"
        }
      ],
      "type": "prompt"
    },
    {
      "segments": [
        {
          "type": "text",
          "foreground": "darkGray",
          "style": "plain",
          "template": "\u2500\u256f"
        }
      ],
      "type": "rprompt"
    }
  ],
  "console_title_template": "{{ .UserName }}@{{ .HostName }}:{{ .Shell }} {{ .PWD }}",
  "transient_prompt": {
    "foreground": "green",
    "foreground_templates": [
      "{{ if gt .Code 0 }}#CC2222{{ end }}",
      "{{ if eq .Code 0 }}green{{ end }}"
    ],
    "template": "\u276f "
  },
  "secondary_prompt": {
    "foreground": "#D3D7CF",
    "template": "\u276f\u276f "
  },
  "final_space": true,
  "version": 4
}
